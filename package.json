{
  "name": "dsh-bug-gps",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijiaqi-AI-Product-Manager/dsh-bug-gps.git"
  },
  "bugs": {
    "url": "https://github.com/lijiaqi-AI-Product-Manager/dsh-bug-gps/issues"
  },
  "homepage": "https://github.com/lijiaqi-AI-Product-Manager/dsh-bug-gps#readme",
  "description": "BugGPS for DeepSeek Harness: record a browser bug once, lock it as a failing check, and let the agent fix it until the check really passes.",
  "type": "module",
  "main": "src/dsh/index.js",
  "bin": {
    "buggps": "bin/buggps.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:package": "node test/package-smoke.mjs",
    "test:live-model": "node test/e2e/live-model.mjs",
    "bench": "node bench/run.mjs",
    "demo:gif": "node docs/demo/make-demo.mjs",
    "demo:toolbar": "node docs/demo/capture-toolbar.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.5"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bug-reproduction",
    "browser-debugging",
    "playwright"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  }
}
