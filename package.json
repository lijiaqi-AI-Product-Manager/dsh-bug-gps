{
  "name": "dsh-bug-gps",
  "version": "1.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijiaqi-AI-Product-Manager/dsh-bug-gps.git"
  },
  "bugs": {
    "url": "https://github.com/lijiaqi-AI-Product-Manager/dsh-bug-gps/issues"
  },
  "homepage": "https://github.com/lijiaqi-AI-Product-Manager/dsh-bug-gps#readme",
  "description": "BugGPS：录制浏览器问题、固定预期，并以独立原代码对照复核修复。Browser bug reproduction and fix verification for DeepSeek Harness.",
  "type": "module",
  "main": "src/dsh/index.js",
  "bin": {
    "buggps": "bin/buggps.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "assets/buggps-icon.png",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "marketplace": {
      "profiles": [
        "headless",
        "web"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": true
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:package": "node test/package-smoke.mjs",
    "test:live-model": "node test/e2e/live-model.mjs",
    "check:distribution": "node scripts/prepare-distribution.mjs",
    "bench": "node bench/run.mjs",
    "demo:gif": "node docs/demo/make-demo.mjs",
    "demo:toolbar": "node docs/demo/capture-toolbar.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.5"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bug-reproduction",
    "browser-debugging",
    "playwright",
    "regression-testing",
    "cordis-plugin",
    "debugging"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
