      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "日语"
        },
        {
          "by": "css",
          "value": "#headlessui-radiogroup-option-\\:r5\\:"
        }
      ]
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "英语"
        },
        {
          "by": "css",
          "value": "#headlessui-radiogroup-option-\\:r3\\:"
        }
      ]
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "考研"
        },
        {
          "by": "css",
          "value": "#headlessui-radiogroup-option-\\:ra5\\:"
        }
      ]
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "大学英语"
