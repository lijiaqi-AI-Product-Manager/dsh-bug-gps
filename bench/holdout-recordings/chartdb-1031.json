{
  "schema": "buggps.draft/v1",
  "source": "scripted",
  "browser": {
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "locale": "zh-CN",
    "timezoneId": "Asia/Shanghai",
    "deviceScaleFactor": 1
  },
  "observeMs": 1000,
  "steps": [
    {
      "action": "goto",
      "url": "/"
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "Toggle bold"
        },
        {
          "by": "role",
          "role": "radio",
          "name": "Toggle bold",
          "child": {
            "role": "img",
            "name": "PostgreSQL"
          }
        }
      ]
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "SQL Script"
        }
      ]
    },
    {
      "action": "fill",
      "target": [
        {
          "by": "role",
          "role": "textbox",
          "name": "Editor content"
        }
      ],
      "value": "CREATE TABLE invoice (amount decimal(15,2));"
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "button",
          "name": "Import"
        }
      ]
    },
    {
      "action": "click",
      "target": [
        {
          "by": "text",
          "value": "invoice"
        }
      ]
    }
  ],
  "expectation": {
    "kind": "count",
    "target": [
      {
        "by": "css",
        "value": "aside :text-is(\"numeric(15,2)\")"
      }
    ],
    "equals": 1
  },
  "also": [
    {
      "kind": "value",
      "target": [
        {
          "by": "role",
          "role": "textbox",
          "name": "Name"
        }
      ],
      "equals": "amount"
    }
  ],
  "rawSteps": [
    {
      "action": "goto",
      "url": "/"
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "Toggle bold"
        },
        {
          "by": "role",
          "role": "radio",
          "name": "Toggle bold",
          "child": {
            "role": "img",
            "name": "PostgreSQL"
          }
        }
      ]
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "radio",
          "name": "SQL Script"
        }
      ]
    },
    {
      "action": "fill",
      "target": [
        {
          "by": "role",
          "role": "textbox",
          "name": "Editor content"
        }
      ],
      "value": "CREATE TABLE invoice (amount decimal(15,2));"
    },
    {
      "action": "click",
      "target": [
        {
          "by": "role",
          "role": "button",
          "name": "Import"
        }
      ]
    },
    {
      "action": "click",
      "target": [
        {
          "by": "text",
          "value": "invoice"
        }
      ]
    }
  ],
  "targetOverrides": []
}
